arduino_serial: &uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
	status = "okay";
};

/ {
	aliases {
		u1 = &uart0;
	};


	chosen {
		zephyr,console = &arduino_serial;
		zephyr,shell-uart = &arduino_serial;
		zephyr,uart-mcumgr = &arduino_serial;
		zephyr,bt-mon-uart = &arduino_serial;
		zephyr,bt-c2h-uart = &arduino_serial;
	};
};
